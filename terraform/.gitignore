# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
*.tfvars.json

# But allow example files and environment templates
!terraform.tfvars.example
!environments/**/*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore kubeconfig files
kubeconfig.yaml
*.kubeconfig

# Lock files (keep this in source control)
# .terraform.lock.hcl
